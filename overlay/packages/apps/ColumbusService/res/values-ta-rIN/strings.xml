    <string name="launch_settings_activity_title">\'விரைவுத் தட்டல்\' அமைப்புகள்</string>
    <string name="setting_app_selection_help_text" product="default">உங்கள் மொபைலின் பின்புறத்தில் இருமுறை தட்டும்போது திறக்க வேண்டிய ஆப்ஸைத் தேர்ந்தெடுக்கவும். ஆப்ஸை நிறுவல் நீக்கினால் நீங்கள் வேறொரு ஆப்ஸைத் தேர்ந்தெடுக்கும் வரை \'விரைவுத் தட்டல்\' முடக்கப்பட்டிருக்கும்.</string>
    <string name="setting_app_selection_help_text" product="device">Select an app to open when you tap the back of your device twice. If you uninstall the app, Quick Tap turns off until you select a different app.</string>
    <string name="setting_app_selection_help_text" product="tablet">Select an app to open when you tap the back of your tablet twice. If you uninstall the app, Quick Tap turns off until you select a different app.</string>
    <string name="setting_app_selection_help_text_disabled">To use this feature, you have to enable the Quick Tap first.</string>
    <string name="setting_app_shortcut_selection_help_text">\'விரைவுத் தட்டல்\' சைகையைப் பயன்படுத்தி இந்த ஆப்ஸைத் திறக்கும்போது என்ன நடக்க வேண்டும் என்பதைத் தேர்ந்தெடுக்கவும்.</string>
    <string name="setting_app_shortcut_selection_help_text_disabled">@string/setting_app_selection_help_text_disabled</string>
